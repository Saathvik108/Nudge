# Postgres connection string. On Vercel, set this in Project Settings →
# Environment Variables. Locally, point it at a free Neon/Supabase DB
# (or a local Postgres). Example shapes:
#   Neon:     postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/nudge?sslmode=require
#   Supabase: postgresql://postgres:PASSWORD@db.xxx.supabase.co:5432/postgres
#   Local:    postgresql://postgres:postgres@localhost:5432/nudge
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Optional: set ANTHROPIC_API_KEY to wire Max to the real Claude API.
# Without it, Max returns deterministic stubbed responses driven by the
# system prompt in src/lib/max/system-prompt.ts.
# ANTHROPIC_API_KEY=
