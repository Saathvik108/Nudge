# No configuration required. The app ships with an embedded, pre-seeded
# SQLite database that is unpacked automatically at runtime (see
# src/lib/db.ts), so it deploys to Vercel with zero setup.
#
# Optional: point at your own database instead (e.g. a persistent Postgres).
# If you do, also change the datasource provider in prisma/schema.prisma.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Optional: set ANTHROPIC_API_KEY to wire Max to the real Claude API.
# Without it, Max returns deterministic stubbed responses driven by the
# system prompt in src/lib/max/system-prompt.ts.
# ANTHROPIC_API_KEY=
